# TCRIA Production Environment (.env.production)
# Copy this to your Digital Ocean server and fill in the values
# NEVER commit actual secrets to git

# ============================================
# REQUIRED - Must be set before deployment
# ============================================

# JWT Secret for API authentication (generate with: openssl rand -hex 32)
TCRIA_MCP_JWT_SECRET=your-secure-jwt-secret-here

# Signing Secret for signed requests (generate with: openssl rand -hex 32)
TCRIA_MCP_SIGNING_SECRET=your-secure-signing-secret-here

# Public URL of your TCRIA instance
TCRIA_MCP_PUBLIC_URL=https://tcria.your-domain.com/mcp

# Whether to require authentication
TCRIA_MCP_REQUIRE_AUTH=true

# ============================================
# OPTIONAL - Set if using AI features
# ============================================

# OpenAI API Key (for AI-powered audit summaries)
# OPENAI_API_KEY=sk-...

# ============================================
# OPTIONAL - Set if using GitHub integration
# ============================================

# GitHub Personal Access Token
# GITHUB_TOKEN=ghp_...

# ============================================
# Python Runtime
# ============================================

PYTHONUNBUFFERABLE=1
PYTHONDONTWRITEBYTECODE=1
PORT=8000